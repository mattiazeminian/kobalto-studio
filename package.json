{
  "name": "kobalto-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components src/content src/motion.ts next.config.mjs postcss.config.mjs",
    "format:check": "prettier --check app components src/content/site.ts src/motion.ts eslint.config.mjs next.config.mjs postcss.config.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "motion": "13.1.1",
    "next": "15.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "postcss": "8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
